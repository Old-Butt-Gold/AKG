<Window x:Class="AKG.UI.LightEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:AKG.UI.Converters"
        mc:Ignorable="d"
        Title="Edit Light" Width="300" Height="250">
    <Window.Resources>
        <converters:Vector3ToStringConverter x:Key="Vector3Converter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Position Label -->
            <RowDefinition Height="Auto" /> <!-- Position TextBox -->
            <RowDefinition Height="Auto" /> <!-- Color Label -->
            <RowDefinition Height="Auto" /> <!-- Color TextBox -->
            <RowDefinition Height="Auto" /> <!-- Intensity Label -->
            <RowDefinition Height="Auto" /> <!-- Intensity TextBox -->
            <RowDefinition Height="Auto" /> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Позиция -->
        <TextBlock Text="Position:" Grid.Row="0" Margin="5" />
        <TextBox Text="{Binding TempDirection, Converter={StaticResource Vector3Converter}, Mode=TwoWay}"
                 Grid.Row="1" Margin="5" />

        <!-- Цвет -->
        <TextBlock Text="Color:" Grid.Row="2" Margin="5" />
        <TextBox Text="{Binding TempColor, Converter={StaticResource Vector3Converter}, Mode=TwoWay}"
                 Grid.Row="3" Margin="5" />

        <!-- Интенсивность -->
        <TextBlock Text="Intensity:" Grid.Row="4" Margin="5" />
        <TextBox Text="{Binding TempIntensity, Mode=TwoWay}"
                 Grid.Row="5" Margin="5" />

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="OK" Width="75" Margin="5" Click="OKButton_Click" />
            <Button Content="Cancel" Width="75" Margin="5" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>